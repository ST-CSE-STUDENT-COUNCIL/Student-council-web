# ============================================================================
# 루트 .gitignore - 모든 서브프로젝트 공통 설정
# ============================================================================
# 각 서브프로젝트(backend, fe, fe-demo, database)는 자체 .gitignore 보유
# ============================================================================

# Environment Variables (전역)
.env
.env.local
.env.*.local

# IDEs & OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Logs (전역)
*.log
logs/

# Temporary files (전역)
*.tmp
*.temp
.cache/

#cursorrules
.cursorrules
# ============================================================================
# 서울과기대 컴공과 학생회 홈페이지 - 백엔드 환경변수
# ============================================================================
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!
# ============================================================================

# ============================================================================
# Supabase 설정
# ============================================================================
# Supabase Dashboard > Settings > API 에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Cloudflare R2 Storage
# ============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ============================================================================
# R2 Public Bucket URLs (각 버킷의 R2.dev 서브도메인)
# ============================================================================
R2_CLUB_IMAGES_URL=https://pub-xxxxx.r2.dev
R2_EVENT_IMAGES_URL=https://pub-xxxxx.r2.dev
R2_INTRODUCTION_IMAGES_URL=https://pub-xxxxx.r2.dev
R2_POST_ATTACHMENTS_URL=https://pub-xxxxx.r2.dev
R2_WELFARE_IMAGES_URL=https://pub-xxxxx.r2.dev

# ============================================================================
# Cloudflare Turnstile (선택사항)
# ============================================================================
# 미설정시 검증 우회 (개발 환경)
# Cloudflare Dashboard > Turnstile 에서 발급
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ============================================================================
# Gmail HTTP API 설정
# ============================================================================
GOOGLE_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REFRESH_TOKEN=your-refresh-token-here
GMAIL_FROM_EMAIL=your-email@gmail.com
GMAIL_FROM_NAME=서울과학기술대학교 컴퓨터공학과 학생회

# ============================================================================
# Google Sheets API 설정
# ============================================================================
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > API 키
# 복지사업 물품대여 재고 조회용
GOOGLE_SHEETS_API_KEY=AIza...your-api-key-here

# ============================================================================
# 보안 설정
# ============================================================================
# 랜덤 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-random-hex

# 허용할 이메일 도메인 (회원가입 제한)
ALLOWED_EMAIL_DOMAIN=seoultech.ac.kr

# ============================================================================
# 환경 설정
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# CORS 설정 (프론트엔드 URL)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# 서버 설정
# ============================================================================
HOST=0.0.0.0
PORT=8000
